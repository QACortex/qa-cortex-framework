# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
*.tgz

# Playwright output
test-results/
playwright-report/
blob-report/
# Report files written by the QA Cortex presets (JUnit, JSON; ADR 0009) and Allure results
reports/
allure-results/
allure-report/

# Secrets: session files (storageState, tokens; see ADR 0004) and environment files
.auth/
.env
.env.*
!.env.example

# Local reference scripts (automation/reference/): source material for the starter project,
# kept on the author's machine only; never tracked
automation/reference/

# Local tool settings
.claude/settings.local.json
.idea/

# Logs, coverage, OS files
*.log
coverage/
.DS_Store
Thumbs.db
