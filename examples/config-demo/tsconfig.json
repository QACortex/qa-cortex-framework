{
  // A typical consumer setup (ADR 0001): nodenext, our types checked (skipLibCheck off).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["playwright.config.ts", "qa.config.ts", "tests", "scripts"]
}
