{
  "name": "@qa-cortex/core",
  "version": "0.0.0",
  "description": "QA Cortex core modules for Playwright: configuration, structured logging, secrets, the production guard and reporter/artifact presets.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "default": "./dist/secrets/index.js"
    },
    "./guard": {
      "types": "./dist/guard/index.d.ts",
      "default": "./dist/guard/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "default": "./dist/presets/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.60.0 <2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
