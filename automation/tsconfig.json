{
  // A typical consumer setup (ADR 0001): nodenext, our types checked (skipLibCheck off).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true
  },
  // reference/ (local reference scripts) is deliberately not included.
  "include": ["playwright.config.ts", "qa.config.ts", "qa.secrets.ts", "tests", "pages", "components", "data", "scripts"]
}
