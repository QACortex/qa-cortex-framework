# Local secrets for this project. Copy this file to .env and replace the placeholders:
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
#
# .env is gitignored; this example file is the only one committed, and it holds placeholders
# only. Never put a real secret in this file. In CI, set these as real environment variables
# (repository secrets) instead; variables already set in the environment win over .env.
#
# qa.secrets.ts declares which variables are read, for which profile.

# Required in every profile. A SYNTHETIC token for the logging demo (any value, 4+ characters).
QA_DEMO_TOKEN=replace-with-any-synthetic-value

# Optional, per profile: only staging and production read one.
# QA_STAGING_API_TOKEN=
# QA_PRODUCTION_API_TOKEN=

# Optional in every profile.
# QA_BASIC_AUTH_PASSWORD=
