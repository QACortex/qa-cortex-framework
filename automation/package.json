{
  "name": "qa-cortex-automation",
  "version": "0.0.0",
  "private": true,
  "description": "Ready-to-use Playwright automation project built on @qa-cortex/core: config profiles, fixtures and structured logging.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "framework:pack": "node scripts/pack-framework.mjs",
    "test": "playwright test --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "demo:local": "node scripts/with-profile.mjs local --project=chromium tests/ui/site.spec.ts tests/ui/logging.spec.ts",
    "demo:staging": "node scripts/with-profile.mjs staging --project=chromium tests/ui/site.spec.ts tests/ui/logging.spec.ts",
    "demo:ci": "node scripts/ci-preset-demo.mjs",
    "demo:production": "node scripts/with-profile.mjs production --project=chromium tests/ui/site.spec.ts",
    "demo:production-guard": "node scripts/production-guard-demo.mjs",
    "demo:unknown-profile": "node scripts/with-profile.mjs qa",
    "demo:invalid": "node scripts/invalid-config.mjs",
    "demo:logging": "node scripts/logging-demo.mjs success",
    "demo:logging-failure": "node scripts/logging-demo.mjs failure",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@qa-cortex/core": "file:vendor/qa-cortex-core.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
