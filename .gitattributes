# Normalise line endings: LF in the repository and in working copies on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.gif binary
*.webm binary
*.zip binary
*.tgz binary
