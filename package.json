{
  "name": "qa-cortex",
  "version": "0.0.0",
  "private": true,
  "description": "QA Cortex: a thin, composition-first extension layer over Playwright.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p packages/core/test && tsc -p tsconfig.tools.json && tsc -p examples/config-demo",
    "lint": "eslint .",
    "test": "tsc -b && playwright test",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
